PORT=3000
DB_HOST=84.46.245.240
DB_PORT=6432

# Credencial de RUNTIME de la app (login, dashboards, todo lo que corre en
# produccion/staging normalmente). Debe ser un usuario MySQL propio por
# entorno (app_staging / app_production) creado por `npm run db:create-app-users`,
# con permiso UNICAMENTE `EXECUTE` sobre su base -- nunca dev_admin. La app
# solo hace `CALL sp_...`, nunca toca tablas directo, asi que no necesita mas.
DB_USER=app_staging
DB_PASSWORD=replace-with-secret
DB_NAME=controlProgramaEntrenamientos_staging

# Credencial de MIGRACION (DDL): crea/altera tablas y procedimientos. Solo la
# usan `npm run db:apply-schema` y `npm run db:create-app-users`, nunca el
# servidor. Es el usuario "super admin" de base de datos (p.ej. dev_admin).
MIGRATION_DB_USER=dev_admin
MIGRATION_DB_PASSWORD=replace-with-secret

# Firma de sesiones JWT. Debe ser un secreto distinto por entorno (staging/produccion)
# y nunca compartirse ni versionarse.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Solo se usan al ejecutar `npm run seed:superadmin`, una vez, para crear el
# primer usuario super_admin. No se leen en tiempo de ejecucion del servidor.
SUPERADMIN_EMAIL=replace-with-email
SUPERADMIN_NAME=replace-with-name
SUPERADMIN_PASSWORD=replace-with-a-strong-password
